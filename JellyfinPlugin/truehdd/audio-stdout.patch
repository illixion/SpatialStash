+fn write_pcm_24le<W: Write>(writer: &mut W, samples: &[i32]) -> anyhow::Result<()> {
+    for &sample in samples {
+        let bytes = sample.to_le_bytes();
+        writer.write_all(&bytes[..3])?; // Write 24-bit
+    }
+    Ok(())
